{
  "name": "ad-simulator",
  "version": "1.0.4",
  "description": "System Runtime Service",
  "author": "adlsdztony",
  "main": "main.js",
  "bin": {
    "ad-sim": "./cli.js"
  },
  "scripts": {
    "start": "electron . --popup-count=3 --style=bounce",
    "build": "electron-builder"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.system.runtime",
    "productName": "System Service",
    "files": [
      "main.js",
      "preload.js",
      "popup.html",
      "cli.js"
    ],
    "linux": {
      "target": ["AppImage"]
    },
    "mac": {
      "target": ["zip"]
    },
    "win": {
      "target": ["portable"],
      "executableName": "SystemService"
    }
  }
}
